@host = http://100.99.13.87:5086
@base = {{host}}/api/medicity/distribuida

### 1. Vista general distribuida
GET {{base}}/vistas/general

### 2. Vista de doctores
GET {{base}}/vistas/doctores

### 3. Vista de citas medicas
GET {{base}}/vistas/citas

### 4. Proceso del profesor: crear doctor
POST {{base}}/procesos/doctores/crear
Content-Type: application/json

{
  "nombre": "LUIS",
  "idEspecialidad": 1,
  "idCiudad": 1
}

### 5. Proceso del profesor: actualizar cita
PUT {{base}}/procesos/citas/1/actualizar
Content-Type: application/json

{
  "idPaciente": 2,
  "idDoctor": 2,
  "fechaHora": "2026-12-09T10:00:00"
}

### 6. Proceso propio: crear diagnostico
POST {{base}}/procesos/diagnosticos/crear
Content-Type: application/json

{
  "idCita": 2,
  "nombre": "GRIPE",
  "descripcion": "PACIENTE PRESENTA SINTOMAS DE GRIPE",
  "tratamiento": "REPOSO Y MEDICACION"
}

### 7. Proceso propio: actualizar diagnostico
PUT {{base}}/procesos/diagnosticos/1/actualizar
Content-Type: application/json

{
  "idCita": 1,
  "nombre": "CONTROL",
  "descripcion": "PACIENTE EN CONTROL",
  "tratamiento": "CONTINUAR TRATAMIENTO"
}

### 8. Un doctor por ID
GET {{base}}/vistas/doctores/1

### 9. Una cita medica por ID
GET {{base}}/vistas/citas/1

### 10. Diagnosticos distribuidos
GET {{base}}/vistas/diagnosticos

### 11. Diagnosticos filtrados por cita
GET {{base}}/vistas/diagnosticos?idCita=1

### 12. Diagnosticos filtrados por texto libre
GET {{base}}/vistas/diagnosticos?texto=GRIPE

### 13. Un diagnostico por ID
GET {{base}}/vistas/diagnosticos/1

### 14. Un diagnostico inexistente: 404 controlado
GET {{base}}/vistas/diagnosticos/999999

### 15. Catalogo de ciudades del Sitio A
GET {{base}}/vistas/ciudades

### 16. Catalogo de especialidades del Sitio B
GET {{base}}/vistas/especialidades

### 17. Catalogo de pacientes
GET {{base}}/vistas/pacientes
