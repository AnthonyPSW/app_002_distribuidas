@host = http://100.99.13.87:8088
@base = {{host}}/api/medicity/distribuida

### 1. Vista general distribuida
GET {{base}}/vistas/general

### 2. Vista de doctores
GET {{base}}/vistas/doctores

### 3. Vista de citas medicas
GET {{base}}/vistas/citas

### 4. Proceso del profesor: crear doctor
POST {{base}}/procesos/doctores/crear
Content-Type: application/json

{
  "nombre": "LUIS",
  "idEspecialidad": 1,
  "idCiudad": 1
}

### 5. Proceso del profesor: actualizar cita
PUT {{base}}/procesos/citas/1/actualizar
Content-Type: application/json

{
  "idPaciente": 2,
  "idDoctor": 2,
  "fechaHora": "2026-12-09T10:00:00"
}

### 6. Proceso propio: crear diagnostico
POST {{base}}/procesos/diagnosticos/crear
Content-Type: application/json

{
  "idCita": 2,
  "nombre": "GRIPE",
  "descripcion": "PACIENTE PRESENTA SINTOMAS DE GRIPE",
  "tratamiento": "REPOSO Y MEDICACION"
}

### 7. Proceso propio: actualizar diagnostico
PUT {{base}}/procesos/diagnosticos/1/actualizar
Content-Type: application/json

{
  "idCita": 1,
  "nombre": "CONTROL",
  "descripcion": "PACIENTE EN CONTROL",
  "tratamiento": "CONTINUAR TRATAMIENTO"
}
